---
// index.astro - DoxCheck Landing Page
// No imports needed for this static page
import Layout from '../layouts/Layout.astro'
---

<Layout>
<main>
<!-- HERO -->
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="hero-glow-red"></div>

    <div class="badge">
      <span class="badge-dot"></span>
      Herramienta educativa de privacidad digital
    </div>

    <h1 class="hero-title">
      <span class="line-dim">¿Qué tan fácil</span>
      <span class="line-accent">te encuentran?</span>
    </h1>

    <p class="hero-subtitle">
      DoxCheck analiza tu <strong>exposición digital</strong> y simula cómo un
      atacante podría recolectar información tuya desde internet —
      antes de que ocurra.
    </p>

    <div class="hero-actions">
      <a href="/test" class="btn-primary">
        Descubrir mi riesgo
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href="#que-es" class="btn-secondary">
        ¿Qué es el doxing?
      </a>
    </div>

    <div class="scroll-hint">
      <span>scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- STATS BAR -->
  <div class="stats-bar">
    <div class="stat-item">
      <span class="stat-num">68%</span>
      <span class="stat-label">usuarios en riesgo alto</span>
    </div>
    <div class="stat-item">
      <span class="stat-num">4min</span>
      <span class="stat-label">para completar el análisis</span>
    </div>
    <div class="stat-item">
      <span class="stat-num">100%</span>
      <span class="stat-label">privado — todo en tu navegador</span>
    </div>
    <div class="stat-item">
      <span class="stat-num">0</span>
      <span class="stat-label">datos enviados a servidores</span>
    </div>
  </div>

  <!-- QUÉ ES EL DOXING -->
  <section class="section" id="que-es">
    <div class="doxing-grid">
      <div class="doxing-text reveal">
        <p class="section-tag">// definición</p>
        <h2 class="section-title">
          El doxing no es<br />
          <span class="highlight">ciencia ficción</span>
        </h2>
        <p>
          El <strong>doxing</strong> es la práctica de recolectar y publicar información
          privada de una persona sin su consentimiento, usando únicamente datos públicos
          disponibles en internet.
        </p>
        <p>
          No requiere habilidades técnicas avanzadas. Con tu nombre de usuario, una foto
          y acceso a redes sociales públicas, alguien puede construir un perfil completo
          sobre ti en <strong>menos de 15 minutos</strong>.
        </p>
        <p>
          La mayoría de las víctimas no saben que están expuestas
          <strong>hasta que es demasiado tarde</strong>.
        </p>
      </div>

      <div class="threat-list reveal">
        <p class="section-tag">// consecuencias reales</p>

        <div class="threat-card">
          <span class="threat-icon">📍</span>
          <div>
            <div class="threat-label">Exposición de ubicación</div>
            <div class="threat-desc">Tus fotos revelan dónde vivís, trabajás y te movés</div>
          </div>
        </div>

        <div class="threat-card">
          <span class="threat-icon">🎭</span>
          <div>
            <div class="threat-label">Robo de identidad</div>
            <div class="threat-desc">Datos públicos combinados pueden suplantar tu identidad</div>
          </div>
        </div>

        <div class="threat-card">
          <span class="threat-icon">📧</span>
          <div>
            <div class="threat-label">Acoso dirigido</div>
            <div class="threat-desc">Username repetido permite encontrarte en todas las plataformas</div>
          </div>
        </div>

        <div class="threat-card">
          <span class="threat-icon">💰</span>
          <div>
            <div class="threat-label">Extorsión</div>
            <div class="threat-desc">Información personal usada como herramienta de presión</div>
          </div>
        </div>

        <div class="threat-card">
          <span class="threat-icon">⚠️</span>
          <div>
            <div class="threat-label">Violencia digital</div>
            <div class="threat-desc">El doxing es el primer paso de ataques más graves</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <div class="how-section">
    <div class="how-inner">
      <p class="section-tag reveal">// cómo funciona doxcheck</p>
      <h2 class="section-title reveal">Cuatro pasos para conocer<br />tu exposición real</h2>

      <div class="steps-grid">
        <div class="step-card reveal">
          <div class="step-num">PASO 01</div>
          <div class="step-icon-wrap">📋</div>
          <div class="step-title">Test de exposición</div>
          <p class="step-desc">Respondés preguntas sobre tu presencia en redes, hábitos digitales y configuración de privacidad.</p>
        </div>

        <div class="step-card reveal">
          <div class="step-num">PASO 02</div>
          <div class="step-icon-wrap">🧮</div>
          <div class="step-title">Cálculo de riesgo</div>
          <p class="step-desc">El sistema pondera cada factor y genera un score de exposición del 0 al 100 con nivel de riesgo.</p>
        </div>

        <div class="step-card reveal">
          <div class="step-num">PASO 03</div>
          <div class="step-icon-wrap">🔍</div>
          <div class="step-title">Simulación OSINT</div>
          <p class="step-desc">Visualizás paso a paso cómo un atacante usaría tu información pública para encontrarte.</p>
        </div>

        <div class="step-card reveal">
          <div class="step-num">PASO 04</div>
          <div class="step-icon-wrap">🛡️</div>
          <div class="step-title">Recomendaciones</div>
          <p class="step-desc">Recibís consejos personalizados según tus factores de riesgo detectados para protegerte.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- FEATURES -->
  <section class="section">
    <p class="section-tag reveal">// funcionalidades</p>
    <h2 class="section-title reveal">Todo lo que incluye<br />el análisis</h2>

    <div class="features-grid">
      <div class="feature-card reveal">
        <span class="feature-tag">TEST</span>
        <div class="feature-title">Test de exposición digital</div>
        <p class="feature-desc">Preguntas sobre Instagram, ubicación, teléfono visible, usernames repetidos y más. Calcula un score de 0 a 100.</p>
      </div>

      <div class="feature-card reveal">
        <span class="feature-tag">ANÁLISIS</span>
        <div class="feature-title">Score de riesgo visual</div>
        <p class="feature-desc">Gauge animado con tu puntaje, nivel de riesgo (bajo/medio/alto/crítico) y desglose por categorías en gráfica.</p>
      </div>

      <div class="feature-card reveal">
        <span class="feature-tag">SIMULACIÓN</span>
        <div class="feature-title">Simulador OSINT</div>
        <p class="feature-desc">Animación que muestra paso a paso cómo un atacante te investigaría usando inteligencia de fuentes abiertas.</p>
      </div>

      <div class="feature-card reveal">
        <span class="feature-tag">CONSEJOS</span>
        <div class="feature-title">Recomendaciones personalizadas</div>
        <p class="feature-desc">Solo recibís los consejos que aplican a tu situación. No genéricos — basados en tus factores de riesgo reales.</p>
      </div>

      <div class="feature-card reveal">
        <span class="feature-tag">PRIVACIDAD</span>
        <div class="feature-title">100% en tu navegador</div>
        <p class="feature-desc">Ningún dato sale de tu dispositivo. Todo el procesamiento ocurre en el cliente. Zero telemetría.</p>
      </div>

      <div class="feature-card reveal">
        <span class="feature-tag">OPCIONAL</span>
        <div class="feature-title">Analizador de metadatos</div>
        <p class="feature-desc">Subí una foto y detectá si contiene GPS, modelo de cámara o fecha oculta. Descargá la versión limpia.</p>
        <span class="feature-optional">+ función extra</span>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="cta-section">
    <p class="section-tag">// empezá ahora</p>
    <h2 class="cta-title">
      Tu privacidad<br />
      <span>empieza con saber</span>
    </h2>
    <p class="cta-sub">El análisis toma menos de 4 minutos. Sin registro. Sin datos guardados.</p>
    <div class="cta-btn-wrap">
      <a href="/test" class="btn-primary" style="font-size:1.05rem; padding: 1rem 2.5rem;">
        Analizar mi exposición
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>
</main>

</Layout>



  <!-- SCROLL REVEAL SCRIPT -->
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.add('visible');
            }, i * 80);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>







 
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #080b10;
      --surface: #0e1320;
      --surface2: #141b2d;
      --border: rgba(255,255,255,0.06);
      --accent: #e8ff47;
      --accent2: #ff4d6d;
      --accent3: #47c5ff;
      --text: #e8eaf0;
      --muted: #6b7280;
      --font-display: 'Syne', sans-serif;
      --font-mono: 'DM Mono', monospace;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-display);
      overflow-x: hidden;
    }

    /* NOISE TEXTURE OVERLAY */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
      opacity: 0.4;
    }

    /* NAV */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.2rem 3rem;
      border-bottom: 1px solid var(--border);
      background: rgba(8, 11, 16, 0.85);
      backdrop-filter: blur(20px);
    }

    .nav-logo {
      font-family: var(--font-mono);
      font-size: 1rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      color: var(--accent);
      text-decoration: none;
    }

    .nav-logo span {
      color: var(--muted);
    }

    .nav-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1.2rem;
      background: var(--accent);
      color: #080b10;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 500;
      text-decoration: none;
      letter-spacing: 0.05em;
      transition: all 0.2s;
    }

    .nav-cta:hover {
      background: #fff;
      transform: translateY(-1px);
    }

    /* HERO */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 8rem 2rem 4rem;
      text-align: center;
      overflow: hidden;
    }

    /* GRID BACKGROUND */
    .hero::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(232,255,71,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(232,255,71,0.03) 1px, transparent 1px);
      background-size: 60px 60px;
      pointer-events: none;
    }

    /* GLOW */
    .hero-glow {
      position: absolute;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(232,255,71,0.06) 0%, transparent 70%);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -60%);
      pointer-events: none;
    }

    .hero-glow-red {
      position: absolute;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,77,109,0.05) 0%, transparent 70%);
      top: 60%;
      right: 10%;
      pointer-events: none;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.35rem 0.8rem;
      border: 1px solid rgba(232,255,71,0.3);
      background: rgba(232,255,71,0.05);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      color: var(--accent);
      margin-bottom: 2rem;
      animation: fadeUp 0.6s ease both;
    }

    .badge-dot {
      width: 6px;
      height: 6px;
      background: var(--accent);
      border-radius: 50%;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.8); }
    }

    .hero-title {
      font-size: clamp(3.5rem, 9vw, 7.5rem);
      font-weight: 800;
      line-height: 0.95;
      letter-spacing: -0.03em;
      margin-bottom: 1.5rem;
      animation: fadeUp 0.6s 0.1s ease both;
      position: relative;
      z-index: 1;
    }

    .hero-title .line-accent {
      color: var(--accent);
      display: block;
    }

    .hero-title .line-dim {
      color: rgba(232, 234, 240, 0.25);
      display: block;
    }

    .hero-subtitle {
      max-width: 540px;
      font-family: var(--font-mono);
      font-size: 0.95rem;
      font-weight: 300;
      line-height: 1.7;
      color: var(--muted);
      margin-bottom: 3rem;
      animation: fadeUp 0.6s 0.2s ease both;
      position: relative;
      z-index: 1;
    }

    .hero-subtitle strong {
      color: var(--text);
      font-weight: 400;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
      animation: fadeUp 0.6s 0.3s ease both;
      position: relative;
      z-index: 1;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.9rem 2rem;
      background: var(--accent);
      color: #080b10;
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 700;
      text-decoration: none;
      letter-spacing: 0.02em;
      transition: all 0.25s;
      position: relative;
      overflow: hidden;
    }

    .btn-primary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(255,255,255,0.2);
      transform: translateX(-100%);
      transition: transform 0.3s;
    }

    .btn-primary:hover::before { transform: translateX(0); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(232,255,71,0.25); }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.9rem 1.8rem;
      border: 1px solid var(--border);
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.85rem;
      text-decoration: none;
      transition: all 0.2s;
    }

    .btn-secondary:hover {
      border-color: rgba(255,255,255,0.2);
      color: var(--text);
    }

    /* SCROLL INDICATOR */
    .scroll-hint {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      color: var(--muted);
      animation: fadeUp 1s 0.8s ease both;
    }

    .scroll-line {
      width: 1px;
      height: 40px;
      background: linear-gradient(to bottom, var(--muted), transparent);
      animation: scrollDown 1.5s infinite;
    }

    @keyframes scrollDown {
      0% { transform: scaleY(0); transform-origin: top; }
      50% { transform: scaleY(1); transform-origin: top; }
      51% { transform: scaleY(1); transform-origin: bottom; }
      100% { transform: scaleY(0); transform-origin: bottom; }
    }

    /* STATS BAR */
    .stats-bar {
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 1.5rem 3rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      background: var(--surface);
      overflow-x: auto;
    }

    .stat-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 3rem;
      border-right: 1px solid var(--border);
    }

    .stat-item:last-child { border-right: none; }

    .stat-num {
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--accent);
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    .stat-label {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--muted);
      letter-spacing: 0.08em;
      margin-top: 0.3rem;
    }

    /* WHAT IS DOXING */
    .section {
      padding: 6rem 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .section-tag {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      color: var(--accent);
      text-transform: uppercase;
      margin-bottom: 1rem;
    }

    .section-title {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: 1.5rem;
    }

    .section-title .highlight {
      color: var(--accent2);
    }

    /* DOXING EXPLANATION */
    .doxing-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }

    .doxing-text p {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      line-height: 1.8;
      color: rgba(232,234,240,0.65);
      margin-bottom: 1.2rem;
    }

    .doxing-text p strong {
      color: var(--text);
      font-weight: 500;
    }

    /* THREAT CARDS */
    .threat-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .threat-card {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.2rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-left: 3px solid var(--accent2);
      transition: all 0.2s;
    }

    .threat-card:hover {
      border-color: var(--accent2);
      background: var(--surface2);
      transform: translateX(4px);
    }

    .threat-icon {
      font-size: 1.2rem;
      flex-shrink: 0;
    }

    .threat-label {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--text);
    }

    .threat-desc {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--muted);
      margin-top: 0.1rem;
    }

    /* HOW IT WORKS */
    .how-section {
      background: var(--surface);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 6rem 2rem;
    }

    .how-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      margin-top: 3rem;
      border: 1px solid var(--border);
    }

    .step-card {
      padding: 2rem 1.5rem;
      border-right: 1px solid var(--border);
      position: relative;
      transition: background 0.2s;
    }

    .step-card:last-child { border-right: none; }
    .step-card:hover { background: var(--surface2); }

    .step-num {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      color: var(--muted);
      margin-bottom: 1rem;
    }

    .step-icon-wrap {
      width: 44px;
      height: 44px;
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      margin-bottom: 1rem;
      background: rgba(232,255,71,0.04);
    }

    .step-title {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      letter-spacing: -0.01em;
    }

    .step-desc {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      line-height: 1.6;
      color: var(--muted);
    }

    /* FEATURES */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--border);
      margin-top: 3rem;
      border: 1px solid var(--border);
    }

    .feature-card {
      background: var(--bg);
      padding: 2rem;
      position: relative;
      overflow: hidden;
      transition: background 0.2s;
    }

    .feature-card:hover { background: var(--surface); }

    .feature-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--accent), transparent);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s;
    }

    .feature-card:hover::before { transform: scaleX(1); }

    .feature-tag {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      color: var(--accent);
      border: 1px solid rgba(232,255,71,0.2);
