---
import BaseLayout from '../layouts/Layout.astro';
import logoSprite from '../assets/recom.png'; // Cambié el nombre a logoSprite para ser más descriptivo
---

<BaseLayout title="Prevención de Violencia Digital - DoxCheck">
  <div class="page-container">
    <div class="content-wrapper">

      <!-- Hero Header -->
      <div class="header">
        <div class="tag">GUÍA DE PROTECCIÓN</div>
        <h1 class="main-title">
          Prevención de<br/><span class="accent-text">Violencia Digital</span>
        </h1>
        <p class="subtitle">
          20 recomendaciones esenciales para protegerte en el entorno digital
        </p>
        <div class="scan-line"></div>
      </div>

      <!-- Stats bar -->
      <div class="stats-bar">
        <div class="stat-item">
          <span class="stat-num">20</span>
          <span class="stat-label">Recomendaciones</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num danger">7</span>
          <span class="stat-label">Urgentes</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num warn">8</span>
          <span class="stat-label">Importantes</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num ok">5</span>
          <span class="stat-label">Recomendadas</span>
        </div>
      </div>

      <!-- Section: URGENTE -->
      <div class="section-block">
        <div class="section-label urgent-label">
          <span class="dot dot-urgent"></span>
          ACCIONES URGENTES
        </div>

        <div class="cards-grid">

          <!-- Card 1 - Protege tus contraseñas (posición 10% 10%) -->
          <div class="rec-card urgency-high">
            <div class="card-badge badge-high">URGENTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-1"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Protege tus contraseñas</h3>
              <p class="card-text">
                Usa contraseñas únicas y largas para cada cuenta. Activa el gestor de contraseñas y nunca las compartas, ni siquiera con personas de confianza.
              </p>
              <div class="card-tags">
                <span class="ctag">Cuentas</span>
                <span class="ctag">Acceso</span>
              </div>
            </div>
          </div>

          <!-- Card 2 - Denuncia el ciberacoso (posición 30% 10%) -->
          <div class="rec-card urgency-high">
            <div class="card-badge badge-high">URGENTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-2"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Denuncia el ciberacoso</h3>
              <p class="card-text">
                Si recibes mensajes amenazantes o acoso en línea, documenta todo (capturas de pantalla) y repórtalo a la plataforma y a las autoridades sin demora.
              </p>
              <div class="card-tags">
                <span class="ctag">Acoso</span>
                <span class="ctag">Denuncia</span>
              </div>
            </div>
          </div>

          <!-- Card 3 - Nunca compartas contenido íntimo (posición 50% 10%) -->
          <div class="rec-card urgency-high">
            <div class="card-badge badge-high">URGENTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-3"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Nunca compartas contenido íntimo</h3>
              <p class="card-text">
                No envíes fotos o videos íntimos por plataformas digitales. El sexting puede usarse como herramienta de coacción y chantaje (sextorsión).
              </p>
              <div class="card-tags">
                <span class="ctag">Privacidad</span>
                <span class="ctag">Sextorsión</span>
              </div>
            </div>
          </div>

          <!-- Card 4 - Revisa tu exposición pública (posición 70% 10%) -->
          <div class="rec-card urgency-high">
            <div class="card-badge badge-high">URGENTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-4"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Revisa tu exposición pública</h3>
              <p class="card-text">
                Audita qué información tuya es visible públicamente. Nombre, foto, ubicación, trabajo y teléfono accesibles crean un perfil de riesgo completo.
              </p>
              <div class="card-tags">
                <span class="ctag">Exposición</span>
                <span class="ctag">Datos</span>
              </div>
            </div>
          </div>

          <!-- Card 5 - Bloquea y reporta agresores (posición 90% 10%) -->
          <div class="rec-card urgency-high">
            <div class="card-badge badge-high">URGENTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-5"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Bloquea y reporta agresores</h3>
              <p class="card-text">
                No respondas a provocaciones en línea. Bloquea de inmediato a quienes te agreden y usa las herramientas de reporte de cada plataforma.
              </p>
              <div class="card-tags">
                <span class="ctag">Bloqueo</span>
                <span class="ctag">Reporte</span>
              </div>
            </div>
          </div>

          <!-- Card 6 - Activa 2FA (posición 10% 35%) -->
          <div class="rec-card urgency-high">
            <div class="card-badge badge-high">URGENTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-6"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Activa 2FA en todas tus cuentas</h3>
              <p class="card-text">
                La autenticación de dos factores evita accesos no autorizados incluso si alguien obtiene tu contraseña. Actívala en correo, redes y bancos.
              </p>
              <div class="card-tags">
                <span class="ctag">2FA</span>
                <span class="ctag">Seguridad</span>
              </div>
            </div>
          </div>

          <!-- Card 7 - Desactiva seguimiento (posición 30% 35%) -->
          <div class="rec-card urgency-high">
            <div class="card-badge badge-high">URGENTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-7"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Desactiva el seguimiento de ubicación</h3>
              <p class="card-text">
                Apaga el GPS en fotos y publicaciones. No compartas tu ubicación en tiempo real en redes sociales: facilita el acoso físico y el stalking digital.
              </p>
              <div class="card-tags">
                <span class="ctag">Ubicación</span>
                <span class="ctag">Stalking</span>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Section: IMPORTANTE -->
      <div class="section-block">
        <div class="section-label important-label">
          <span class="dot dot-important"></span>
          ACCIONES IMPORTANTES
        </div>

        <div class="cards-grid">

          <!-- Card 8 - Bienestar digital (posición 50% 35%) -->
          <div class="rec-card urgency-med">
            <div class="card-badge badge-med">IMPORTANTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-8"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Cuida tu bienestar digital</h3>
              <p class="card-text">
                El estrés por violencia digital es real. Establece límites de tiempo en redes, toma descansos y busca apoyo psicológico si sientes ansiedad por el uso de internet.
              </p>
              <div class="card-tags">
                <span class="ctag">Bienestar</span>
                <span class="ctag">Mental</span>
              </div>
            </div>
          </div>

          <!-- Card 9 - Vigila quién te monitorea (posición 70% 35%) -->
          <div class="rec-card urgency-med">
            <div class="card-badge badge-med">IMPORTANTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-9"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Vigila quién te monitorea</h3>
              <p class="card-text">
                Revisa regularmente qué apps tienen acceso a tu cámara, micrófono y contactos. Revoca permisos innecesarios y desinstala aplicaciones sospechosas.
              </p>
              <div class="card-tags">
                <span class="ctag">Permisos</span>
                <span class="ctag">Apps</span>
              </div>
            </div>
          </div>

          <!-- Card 10 - No difundas contenido violento (posición 90% 35%) -->
          <div class="rec-card urgency-med">
            <div class="card-badge badge-med">IMPORTANTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-10"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">No difundas contenido violento</h3>
              <p class="card-text">
                Compartir videos de agresiones o humillaciones amplifica el daño a las víctimas. Denuncia este contenido en lugar de redistribuirlo.
              </p>
              <div class="card-tags">
                <span class="ctag">Contenido</span>
                <span class="ctag">Difusión</span>
              </div>
            </div>
          </div>

          <!-- Card 11 - Edúcate sobre tus derechos (posición 10% 60%) -->
          <div class="rec-card urgency-med">
            <div class="card-badge badge-med">IMPORTANTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-11"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Edúcate sobre tus derechos digitales</h3>
              <p class="card-text">
                Conoce las leyes de protección de datos y privacidad en tu país. Tienes derecho a solicitar eliminación de tus datos y a protección contra el doxing.
              </p>
              <div class="card-tags">
                <span class="ctag">Derechos</span>
                <span class="ctag">Legal</span>
              </div>
            </div>
          </div>

          <!-- Card 12 - Cuidado con los deepfakes (posición 30% 60%) -->
          <div class="rec-card urgency-med">
            <div class="card-badge badge-med">IMPORTANTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-12"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Cuidado con los deepfakes</h3>
              <p class="card-text">
                Los videos manipulados con IA pueden usarse para difamar. Verifica siempre la fuente de videos virales y usa herramientas de detección de deepfakes.
              </p>
              <div class="card-tags">
                <span class="ctag">Deepfake</span>
                <span class="ctag">IA</span>
              </div>
            </div>
          </div>

          <!-- Card 13 - Practica la empatía digital (posición 50% 60%) -->
          <div class="rec-card urgency-med">
            <div class="card-badge badge-med">IMPORTANTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-13"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Practica la empatía digital</h3>
              <p class="card-text">
                Antes de publicar algo sobre otra persona, pregúntate: ¿causaría daño real? El anonimato en internet no justifica el maltrato hacia los demás.
              </p>
              <div class="card-tags">
                <span class="ctag">Empatía</span>
                <span class="ctag">Conducta</span>
              </div>
            </div>
          </div>

          <!-- Card 14 - Identifica el grooming (posición 70% 60%) -->
          <div class="rec-card urgency-med">
            <div class="card-badge badge-med">IMPORTANTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-14"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Identifica el grooming</h3>
              <p class="card-text">
                El grooming es la manipulación online para obtener contenido o acceso a menores. Educa a niños y jóvenes sobre cómo reconocerlo y reportarlo.
              </p>
              <div class="card-tags">
                <span class="ctag">Grooming</span>
                <span class="ctag">Menores</span>
              </div>
            </div>
          </div>

          <!-- Card 15 - No te aísles ante el acoso (posición 90% 60%) -->
          <div class="rec-card urgency-med">
            <div class="card-badge badge-med">IMPORTANTE</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-15"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">No te aísles ante el acoso</h3>
              <p class="card-text">
                Si eres víctima de violencia digital, busca apoyo en personas de confianza. El aislamiento empeora el impacto psicológico: habla con alguien.
              </p>
              <div class="card-tags">
                <span class="ctag">Apoyo</span>
                <span class="ctag">Víctimas</span>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Section: RECOMENDADAS -->
      <div class="section-block">
        <div class="section-label recommended-label">
          <span class="dot dot-recommended"></span>
          BUENAS PRÁCTICAS
        </div>

        <div class="cards-grid">

          <!-- Card 16 - Aprende autodefensa digital (posición 10% 87%) -->
          <div class="rec-card urgency-low">
            <div class="card-badge badge-low">PRÁCTICA</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-16"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Aprende autodefensa digital</h3>
              <p class="card-text">
                Toma cursos básicos de ciberseguridad. Conocer las amenazas te permite anticiparlas y protegerte mejor antes de que ocurran.
              </p>
              <div class="card-tags">
                <span class="ctag">Educación</span>
                <span class="ctag">Ciberseguridad</span>
              </div>
            </div>
          </div>

          <!-- Card 17 - Sé un testigo activo (posición 30% 87%) -->
          <div class="rec-card urgency-low">
            <div class="card-badge badge-low">PRÁCTICA</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-17"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Sé un testigo activo</h3>
              <p class="card-text">
                Si presencias acoso digital hacia otra persona, no ignores la situación. Apoya a la víctima públicamente o en privado, y reporta el contenido dañino.
              </p>
              <div class="card-tags">
                <span class="ctag">Testigo</span>
                <span class="ctag">Comunidad</span>
              </div>
            </div>
          </div>

          <!-- Card 18 - Pide consentimiento (posición 50% 87%) -->
          <div class="rec-card urgency-low">
            <div class="card-badge badge-low">PRÁCTICA</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-18"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Pide consentimiento para publicar fotos</h3>
              <p class="card-text">
                Siempre solicita permiso antes de publicar fotos donde aparezcan otras personas. Publicar sin consentimiento puede ser una forma de violencia digital.
              </p>
              <div class="card-tags">
                <span class="ctag">Consentimiento</span>
                <span class="ctag">Fotos</span>
              </div>
            </div>
          </div>

          <!-- Card 19 - Construye relaciones digitales sanas (posición 70% 87%) -->
          <div class="rec-card urgency-low">
            <div class="card-badge badge-low">PRÁCTICA</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-19"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Construye relaciones digitales sanas</h3>
              <p class="card-text">
                Las relaciones saludables en línea se basan en respeto y consentimiento. Desconfía de quien te presiona para compartir información personal o privada.
              </p>
              <div class="card-tags">
                <span class="ctag">Relaciones</span>
                <span class="ctag">Respeto</span>
              </div>
            </div>
          </div>

          <!-- Card 20 - Di NO al discurso de odio (posición 90% 87%) -->
          <div class="rec-card urgency-low">
            <div class="card-badge badge-low">PRÁCTICA</div>
            <div class="card-icon-wrap">
              <div class="card-icon icon-20"></div>
            </div>
            <div class="card-body">
              <h3 class="card-title">Di NO al discurso de odio</h3>
              <p class="card-text">
                No participar en discursos de odio, desinformación o campañas de linchamiento digital. Detener la cadena de violencia comienza con tus propias acciones en línea.
              </p>
              <div class="card-tags">
                <span class="ctag">Odio</span>
                <span class="ctag">Acción</span>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- CTA Final -->
      <div class="cta-container">
        <div class="cta-box">
          <div class="cta-glow"></div>
          <h2 class="cta-title">¿Necesitas ayuda ahora?</h2>
          <p class="cta-text">
            Si estás sufriendo violencia digital en este momento, no estás sola/solo. 
            Existen recursos y personas que pueden ayudarte.
          </p>
          <div class="cta-buttons">
            <a href="/test" class="btn btn-primary">🔍 Hacer el Test de Riesgo</a>
            <a href="/" class="btn btn-secondary">🏠 Volver al Inicio</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&display=swap');

  :root {
    --bg: #080b10;
    --surface: #0e1320;
    --surface2: #141b2d;
    --border: rgba(255,255,255,0.06);
    --accent: #e8ff47;
    --accent2: #ff4d6d;
    --accent3: #47c5ff;
    --accent-green: #47ffb2;
    --text: #e8eaf0;
    --muted: #6b7280;
    --font-display: 'Syne', sans-serif;
    --font-mono: 'DM Mono', monospace;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  .page-container {
    height: 100%;
    background: var(--bg);
    background-image:
      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(232,255,71,0.06) 0%, transparent 60%),
      repeating-linear-gradient(0deg, transparent, transparent 79px, rgba(255,255,255,0.015) 80px),
      repeating-linear-gradient(90deg, transparent, transparent 79px, rgba(255,255,255,0.015) 80px);
    padding: 60px 20px;
    font-family: var(--font-display);
  }

  .content-wrapper {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ---- HEADER ---- */
  .header {
    text-align: center;
    margin-bottom: 56px;
    position: relative;
  }

  .tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--accent);
    background: rgba(232,255,71,0.08);
    border: 1px solid rgba(232,255,71,0.25);
    border-radius: 4px;
    padding: 6px 16px;
    margin-bottom: 24px;
  }

  .main-title {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 800;
    color: var(--text);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }

  .accent-text {
    color: var(--accent);
    text-shadow: 0 0 40px rgba(232,255,71,0.4), 0 0 80px rgba(232,255,71,0.15);
  }

  .subtitle {
    font-size: 18px;
    color: var(--muted);
    max-width: 500px;
    margin: 0 auto 32px;
    line-height: 1.6;
  }

  .scan-line {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.3;
    margin-top: 40px;
  }

  /* ---- STATS BAR ---- */
  .stats-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 40px;
    margin-bottom: 56px;
    flex-wrap: wrap;
    gap: 24px;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .stat-num {
    font-family: var(--font-mono);
    font-size: 32px;
    font-weight: 500;
    color: var(--accent);
    line-height: 1;
    
  }

  .stat-num.danger { color: var(--accent2); }
  .stat-num.warn { color: #ffb347; }
  .stat-num.ok { color: var(--accent-green); }

  .stat-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border);
  }

  /* ---- SECTION BLOCKS ---- */
  .section-block {
    margin-bottom: 56px;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .urgent-label { color: var(--accent2); }
  .important-label { color: #ffb347; }
  .recommended-label { color: var(--accent-green); }

  .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot-urgent { background: var(--accent2); box-shadow: 0 0 8px var(--accent2); }
  .dot-important { background: #ffb347; box-shadow: 0 0 8px #ffb347; }
  .dot-recommended { background: var(--accent-green); box-shadow: 0 0 8px var(--accent-green); }

  /* ---- CARDS GRID ---- */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  /* ---- CARD ---- */
  .rec-card {
    position: relative;
    background: var(--surface);
    border-radius: 16px;
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .rec-card:hover {
    transform: translateY(-4px);
  }

  .urgency-high {
    border-top: 3px solid var(--accent2);
  }
  .urgency-high:hover {
    border-color: var(--accent2);
    box-shadow: 0 12px 40px rgba(255,77,109,0.2);
  }

  .urgency-med {
    border-top: 3px solid #ffb347;
  }
  .urgency-med:hover {
    border-color: #ffb347;
    box-shadow: 0 12px 40px rgba(255,179,71,0.2);
  }

  .urgency-low {
    border-top: 3px solid var(--accent-green);
  }
  .urgency-low:hover {
    border-color: var(--accent-green);
    box-shadow: 0 12px 40px rgba(71,255,178,0.15);
