---
import BaseLayout from '../layouts/Layout.astro';
import ExposureTest from '../components/test/ExposureTest.jsx';
---

<BaseLayout title="Test de exposición | DoxCheck">

  <!-- Fuentes de la paleta -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <section class="hero">
    <div class="hero-inner">

      <!-- Etiqueta superior -->
      <span class="eyebrow">
        <span class="dot"></span>
        Análisis de huella digital
      </span>

      <!-- Título principal -->
      <h1>
        ¿Qué tan fácil<br/>
        es <em>doxearte</em>?
      </h1>

      <!-- Bajada -->
      <p class="lead">
        Respondé 10 preguntas sobre tus hábitos digitales y descubrí 
        cuánta información tuya está disponible para cualquiera que busque.
      </p>

      <!-- Chips informativos -->
      <div class="chips">
        <span class="chip chip--yellow">Sin registro</span>
        <span class="chip chip--blue">100% privado</span>
        <span class="chip chip--red">Resultados al instante</span>
      </div>

    </div>
  </section>

  <!-- Componente React con hidratación inmediata -->
  <ExposureTest client:load />

</BaseLayout>

<style>
  /* ── Variables locales (reflejan la paleta del diseño) ──────────────────── */
  :root {
    --bg:       #080b10;
    --surface:  #0e1320;
    --surface2: #141b2d;
    --border:   rgba(255,255,255,0.06);
    --accent:   #e8ff47;
    --accent2:  #ff4d6d;
    --accent3:  #47c5ff;
    --text:     #e8eaf0;
    --muted:    #6b7280;
    --font-display: 'Syne', sans-serif;
    --font-mono:    'DM Mono', monospace;
  }

  /* ── Hero ───────────────────────────────────────────────────────────────── */
  .hero {
    padding: 4.5rem 1.5rem 2rem;
    display: flex;
    justify-content: center;
    background: var(--bg);
  }

  .hero-inner {
    max-width: 600px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  /* Etiqueta con punto pulsante */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1);    }
    50%       { opacity: 0.5; transform: scale(0.8); }
  }

  /* Título */
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
    font-weight: 800;
    color: var(--text);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0;
  }

  /* "doxearte" en accent2 (rojo) */
  h1 em {
    font-style: normal;
    color: var(--accent2);
    text-shadow: 0 0 30px rgba(255,77,109,0.4);
  }

  /* Bajada */
  .lead {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.92rem;
    line-height: 1.7;
    max-width: 500px;
    margin: 0;
  }

  /* Chips */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
    border: 1px solid;
  }

  .chip--yellow {
    color: var(--accent);
    border-color: rgba(232,255,71,0.3);
    background: rgba(232,255,71,0.06);
  }

  .chip--blue {
    color: var(--accent3);
    border-color: rgba(71,197,255,0.3);
    background: rgba(71,197,255,0.06);
  }

  .chip--red {
    color: var(--accent2);
    border-color: rgba(255,77,109,0.3);
    background: rgba(255,77,109,0.06);
  }
</style>