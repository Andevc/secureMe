---
// Footer.astro - DoxCheck Footer
import logo from '../../assets/logo.png';
---

<footer class="dox-footer">
  <!-- Glow line top -->
  <div class="footer-glow-line"></div>

  <div class="footer-inner">
    <!-- TOP SECTION -->
    <div class="footer-top">
      <!-- Brand col -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">
            <div class="footer-logo-icon">
                <!-- Reemplazamos el SVG por la imagen PNG -->
                <img src={logo.src} alt="Logo de la app" width="150"  />
            </div>
            <span class="footer-logo-text">Dox<em>Check</em></span>
        </a>

        <p class="footer-tagline">
          Conoce tu exposición digital.<br />Actúa antes de ser víctima.
        </p>
        <div class="footer-badge">
          <span class="badge-dot"></span>
          <span>Herramienta educativa — No almacenamos tus datos</span>
        </div>
      </div>

      <!-- Nav cols -->
      <div class="footer-nav-cols">
        <div class="footer-col">
          <h4 class="footer-col-title">Plataforma</h4>
          <ul>
            <li><a href="#que-es">¿Qué es el doxing?</a></li>
            <li><a href="/test">Test de exposición</a></li>
            <li><a href="/resultados">Ver mi score</a></li>
            <li><a href="/recomendaciones">Recomendaciones</a></li>
          </ul>
        </div>
        <div class="footer-alert">
          <div class="alert-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path
                d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
                stroke="#FF6B1A"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <p>
            <strong>Aviso importante:</strong> DoxCheck es una herramienta de concientización.
            La simulación OSINT no accede ni almacena información real. Si estás siendo
            víctima de doxing, <a href="#">contacta a las autoridades</a>.
          </p>
        </div>
      </div>
    </div>

    <!-- BOTTOM BAR -->
    <div class="footer-bottom">
      <p class="footer-copy">
        © 2026 DoxCheck — Construido para proteger, no para exponer.
      </p>
      <div class="footer-mono">
        <span class="mono-tag">v1.0.0</span>
        <span class="mono-sep">//</span>
        <span class="mono-tag">edu-tool</span>
        <span class="mono-sep">//</span>
        <span class="mono-tag">privacy-first</span>
      </div>
    </div>
  </div>
</footer>
<style>

:root{
  --bg: #080b10;
  --surface: #0e1320;
  --surface2: #141b2d;
  --border: rgba(255,255,255,0.06);

  --accent: #e8ff47;
  --accent2: #ff4d6d;
  --accent3: #47c5ff;

  --text: #e8eaf0;
  --muted: #6b7280;

  --font-display: 'Syne', sans-serif;
  --font-mono: 'DM Mono', monospace;
}

*,*::before,*::after{
box-sizing:border-box;
margin:0;
padding:0;
}

.dox-footer{
position:relative;
background:linear-gradient(
180deg,
var(--surface) 0%,
var(--bg) 100%
);
font-family:var(--font-display);
overflow:hidden;
}

/* background glow */

.dox-footer::before{
content:'';
position:absolute;
inset:0;

background:
radial-gradient(circle at 20% 120%,rgba(71,197,255,.12),transparent 60%),
radial-gradient(circle at 90% -10%,rgba(232,255,71,.08),transparent 60%);

pointer-events:none;
opacity:.9;
}

/* grid texture */

.dox-footer::after{
content:'';
position:absolute;
inset:0;

background-image:
linear-gradient(rgba(255,255,255,0.02) 1px,transparent 1px),
linear-gradient(90deg,rgba(255,255,255,0.02) 1px,transparent 1px);

background-size:40px 40px;
opacity:.3;

pointer-events:none;
}

/* glow top line */

.footer-glow-line{
height:2px;
background:linear-gradient(
90deg,
transparent,
var(--accent3),
var(--accent),
var(--accent3),
transparent
);

box-shadow:0 0 14px rgba(71,197,255,.35);
}

.footer-inner{
position:relative;
z-index:1;
max-width:1200px;
margin:auto;
padding:60px 24px 32px;
}

/* layout */

.footer-top{
display:grid;
grid-template-columns:1.2fr 2fr;
gap:64px;

padding-bottom:48px;
border-bottom:1px solid var(--border);
}

/* logo */

.footer-logo{
display:flex;
align-items:center;
gap:10px;
text-decoration:none;
margin-bottom:20px;
width:fit-content;
}

.footer-logo-icon{
width:42px;
height:42px;

display:flex;
align-items:center;
justify-content:center;

background:var(--surface2);
border:1px solid var(--border);

border-radius:12px;

transition:.3s;
}

.footer-logo:hover .footer-logo-icon{
transform:rotate(-5deg) scale(1.05);
}

.footer-logo-text{
font-size:1.35rem;
font-weight:700;
color:var(--text);
letter-spacing:-.02em;
}

.footer-logo-text em{
color:var(--accent);
font-style:normal;
}

/* tagline */

.footer-tagline{
font-size:.9rem;
color:var(--muted);
line-height:1.6;
margin-bottom:20px;
}

/* badge */

.footer-badge{
display:inline-flex;
align-items:center;
gap:8px;

background:var(--surface2);
border:1px solid var(--border);

border-radius:20px;
padding:6px 14px;

font-family:var(--font-mono);
font-size:.68rem;

color:var(--accent);
}

.badge-dot{
width:7px;
height:7px;

background:var(--accent3);
border-radius:50%;

box-shadow:0 0 6px var(--accent3);

animation:pulse 2.2s infinite;
}

@keyframes pulse{
0%,100%{opacity:1}
50%{opacity:.4}
}

/* nav columns */

.footer-nav-cols{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:32px;
}

.footer-col-title{
font-size:.72rem;

font-family:var(--font-mono);

text-transform:uppercase;
letter-spacing:.15em;

color:var(--accent3);
margin-bottom:16px;
}

.footer-col ul{
list-style:none;

display:flex;
flex-direction:column;
gap:10px;
}

.footer-col a{
font-size:.88rem;

color:var(--muted);

text-decoration:none;

transition:.2s;
}

.footer-col a:hover{
color:var(--text);
padding-left:6px;
}

/* alert */

.footer-alert{
display:flex;
gap:14px;
align-items:flex-start;

background:var(--surface2);

border:1px solid var(--border);
border-left:3px solid var(--accent2);

border-radius:10px;

padding:16px 20px;

margin-top:36px;
}

.footer-alert p{
font-size:.82rem;

color:var(--muted);

line-height:1.6;

font-family:var(--font-mono);
}

.footer-alert strong{
color:var(--accent2);
font-family:var(--font-display);
}

/* bottom */

.footer-bottom{
display:flex;
align-items:center;
justify-content:space-between;
flex-wrap:wrap;

gap:16px;

padding-top:28px;
border-top:1px solid var(--border);
margin-top:28px;
}

.footer-copy{
font-size:.78rem;
color:var(--muted);
}

.footer-mono{
display:flex;
gap:8px;
font-family:var(--font-mono);
font-size:.68rem;
}

.mono-tag{
color:var(--muted);

background:var(--surface2);
padding:3px 8px;

border-radius:4px;

border:1px solid var(--border);

transition:.2s;
}

.mono-tag:hover{
color:var(--accent);
border-color:var(--accent);
}

.mono-sep{
color:#333;
}

/* responsive */

@media(max-width:900px){

.footer-top{
grid-template-columns:1fr;
gap:40px;
}

.footer-nav-cols{
grid-template-columns:repeat(3,1fr);
gap:24px;
}

}

@media(max-width:600px){

.footer-inner{
padding:40px 20px 28px;
}

.footer-nav-cols{
grid-template-columns:1fr 1fr;
gap:28px;
}

.footer-bottom{	
flex-direction:column;
align-items:flex-start;
}

.footer-mono{
flex-wrap:wrap;
}

}

</style>


