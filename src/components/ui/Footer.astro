---
// Footer.astro - DoxCheck Footer
---

<footer class="dox-footer">
  <!-- Glow line top -->
  <div class="footer-glow-line"></div>

  <div class="footer-inner">
    <!-- TOP SECTION -->
    <div class="footer-top">
      <!-- Brand col -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <div class="footer-logo-icon">
            <svg width="26" height="26" viewBox="0 0 28 28" fill="none">
              <path
                d="M14 2L4 6.5V13.5C4 19.2 8.4 24.5 14 26C19.6 24.5 24 19.2 24 13.5V6.5L14 2Z"
                fill="url(#fShieldGrad)"
                stroke="#FF6B1A"
                stroke-width="1.2"></path>
              <path
                d="M10 14l3 3 5-6"
                stroke="#fff"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <defs>
                <linearGradient
                  id="fShieldGrad"
                  x1="4"
                  y1="2"
                  x2="24"
                  y2="26"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop stop-color="#FF6B1A"></stop>
                  <stop offset="1" stop-color="#7a2700"></stop>
                </linearGradient>
              </defs>
            </svg>
          </div>
          <span class="footer-logo-text">Dox<em>Check</em></span>
        </a>
        <p class="footer-tagline">
          Conoce tu exposición digital.<br />Actúa antes de ser víctima.
        </p>
        <div class="footer-badge">
          <span class="badge-dot"></span>
          <span>Herramienta educativa — No almacenamos tus datos</span>
        </div>
      </div>

      <!-- Nav cols -->
      <div class="footer-nav-cols">
        <div class="footer-col">
          <h4 class="footer-col-title">Plataforma</h4>
          <ul>
            <li><a href="#que-es">¿Qué es el doxing?</a></li>
            <li><a href="/test">Test de exposición</a></li>
            <li><a href="/resultados">Ver mi score</a></li>
            <li><a href="/recomendaciones">Recomendaciones</a></li>
          </ul>
        </div>
        <div class="footer-alert">
          <div class="alert-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path
                d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
                stroke="#FF6B1A"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <p>
            <strong>Aviso importante:</strong> DoxCheck es una herramienta de concientización.
            La simulación OSINT no accede ni almacena información real. Si estás siendo
            víctima de doxing, <a href="#">contacta a las autoridades</a>.
          </p>
        </div>
      </div>
    </div>

    <!-- BOTTOM BAR -->
    <div class="footer-bottom">
      <p class="footer-copy">
        © 2026 DoxCheck — Construido para proteger, no para exponer.
      </p>
      <div class="footer-mono">
        <span class="mono-tag">v1.0.0</span>
        <span class="mono-sep">//</span>
        <span class="mono-tag">edu-tool</span>
        <span class="mono-sep">//</span>
        <span class="mono-tag">privacy-first</span>
      </div>
    </div>
  </div>
</footer>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&display=swap");

  :root {
    --orange-50: #fff5ed;
    --orange-500: #ff6b1a;
    --orange-600: #e05500;
    --orange-700: #c94800;
    --orange-900: #7a2700;
    --dark-900: #0c0c0c;
    --dark-800: #111111;
    --dark-700: #181818;
    --dark-600: #222222;
    --text-muted: #666;
    --text-dim: #888;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .dox-footer {
    position: relative;
    background: var(--dark-800);
    font-family: "Syne", sans-serif;
    overflow: hidden;
  }

  /* Subtle noise texture */
  .dox-footer::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
    opacity: 0.4;
  }

  /* Radial glow bottom-left */
  .dox-footer::after {
    content: "";
    position: absolute;
    bottom: -80px;
    left: -80px;
    width: 400px;
    height: 400px;
    background: radial-gradient(
      circle,
      rgba(201, 72, 0, 0.12) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .footer-glow-line {
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--orange-700) 30%,
      var(--orange-500) 50%,
      var(--orange-700) 70%,
      transparent 100%
    );
    opacity: 0.7;
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 24px 32px;
  }

  /* TOP */
  .footer-top {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 64px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* Brand */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-bottom: 20px;
    width: fit-content;
  }

  .footer-logo-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 107, 26, 0.08);
    border: 1px solid rgba(255, 107, 26, 0.2);
    border-radius: 10px;
    transition:
      background 0.25s,
      transform 0.25s;
  }

  .footer-logo:hover .footer-logo-icon {
    background: rgba(255, 107, 26, 0.16);
    transform: rotate(-4deg);
  }

  .footer-logo-text {
    font-size: 1.3rem;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.02em;
  }

  .footer-logo-text em {
    font-style: normal;
    color: var(--orange-500);
  }

  .footer-tagline {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--text-dim);
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .footer-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 107, 26, 0.07);
    border: 1px solid rgba(255, 107, 26, 0.18);
    border-radius: 20px;
    padding: 6px 14px;
    font-family: "DM Mono", monospace;
    font-size: 0.68rem;
    color: #ff8c45;
    letter-spacing: 0.03em;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    background: #3ddc84;
    border-radius: 50%;
    box-shadow: 0 0 6px #3ddc84;
    animation: pulse-dot 2.4s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  /* Nav columns */
  .footer-nav-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .footer-col-title {
    font-size: 0.7rem;
    font-family: "DM Mono", monospace;
    font-weight: 500;
    color: var(--orange-500);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 16px;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col a {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text-dim);
    text-decoration: none;
    transition:
      color 0.2s,
      padding-left 0.2s;
    display: inline-block;
  }

  .footer-col a:hover {
    color: #fff;
    padding-left: 6px;
  }

  /* Alert banner */
  .footer-alert {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: rgba(255, 107, 26, 0.05);
    border: 1px solid rgba(255, 107, 26, 0.18);
    border-left: 3px solid var(--orange-500);
    border-radius: 10px;
    padding: 16px 20px;
    margin: 36px 0 0;
  }

  .alert-icon {
    flex-shrink: 0;
    margin-top: 1px;
  }

  .footer-alert p {
    font-size: 0.82rem;
    color: #999;
    line-height: 1.6;
    font-family: "DM Mono", monospace;
  }

  .footer-alert strong {
    color: var(--orange-500);
    font-family: "Syne", sans-serif;
  }
  .footer-alert a {
    color: var(--orange-500);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Bottom bar */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    margin-top: 28px;
  }

  .footer-copy {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .footer-mono {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: "DM Mono", monospace;
    font-size: 0.68rem;
  }

  .mono-tag {
    color: #555;
    background: rgba(255, 255, 255, 0.04);
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .mono-tag:hover {
    color: var(--orange-500);
    border-color: rgba(255, 107, 26, 0.3);
  }

  .mono-sep {
    color: #333;
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .footer-nav-cols {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 600px) {
    .footer-inner {
      padding: 40px 20px 28px;
    }

    .footer-nav-cols {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-mono {
      flex-wrap: wrap;
    }
  }
</style>
